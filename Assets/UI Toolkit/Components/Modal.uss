.modal_backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--color-backdrop);
}

.modal_panel {
    width: 80%;
    max-width: 900px;
    padding: 48px;
    flex-shrink: 0;
    border-radius: 24px;
    background-color: var(--color-surface);
}

.modal_title {
    font-size: 60px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--color-text);
    margin-bottom: 32px;
}

.modal_message {
    font-size: 44px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--color-text);
    margin-bottom: 32px;
}

.modal_button_row {
    flex-direction: row;
}

.modal_button {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 110px;
    font-size: 44px;
    margin-left: 12px;
    margin-right: 12px;
}

/* Loading overlay: opaque, so the previous game's grid isn't visible underneath */
.loading_backdrop {
    background-color: var(--color-background);
}

/* A ring with one coloured side; GameUIController spins it while generating */
.loading_spinner {
    width: 140px;
    height: 140px;
    margin-bottom: 48px;
    border-width: 14px;
    border-radius: 70px;
    border-color: var(--color-divider);
    border-top-color: var(--color-accent);
}

.loading_cancel_button {
    flex-grow: 0;
    width: 50%;
    margin-top: 32px;
}
