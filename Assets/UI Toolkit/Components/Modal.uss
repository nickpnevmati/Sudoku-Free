.modal_backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
}

.modal_panel {
    width: 80%;
    max-width: 900px;
    padding: 48px;
    flex-shrink: 0;
    border-radius: 24px;
    background-color: rgb(245, 245, 245);
}

.modal_title {
    font-size: 60px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(0, 0, 0);
    margin-bottom: 32px;
}

.modal_message {
    font-size: 44px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(0, 0, 0);
    margin-bottom: 32px;
}

.modal_button_row {
    flex-direction: row;
}

.modal_button {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 110px;
    font-size: 44px;
    margin-left: 12px;
    margin-right: 12px;
}
