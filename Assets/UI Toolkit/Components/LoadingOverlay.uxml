<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Components/Modal.uss?fileID=7433441132597879392&amp;guid=b72c793453ac42609706355c57278b39&amp;type=3#Modal" />
    <ui:VisualElement name="LoadingBackdrop" class="modal_backdrop loading_backdrop">
        <ui:VisualElement name="LoadingSpinner" class="loading_spinner" picking-mode="Ignore" />
        <ui:Label text="Generating puzzle…" name="LoadingMessage" class="modal_message" picking-mode="Ignore" />
