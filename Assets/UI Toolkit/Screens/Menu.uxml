<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; padding-left: 20%; padding-right: 20%; align-items: stretch; align-self: stretch; align-content: center; justify-content: center;">
        <ui:Label text="Sudoku Free" name="Title" style="white-space: nowrap; text-overflow: clip; align-self: center; align-content: auto; font-size: 90px; -unity-text-align: middle-center;" />
        <ui:Button text="Play" name="PlayButton" />
        <ui:Button text="Continue" name="ContinueButton" />
        <ui:Button text="Settings" name="SettingsButton" />
        <ui:Button text="Exit" name="ExitButton" />
    </ui:VisualElement>
</ui:UXML>
