/* Sizes are in reference pixels: Panel Settings scales the UI from a 1080x1920
   reference, so these grow and shrink with the screen. Unstyled text would fall
   back to the theme's 12px, which is tiny at this resolution. */
:root {
    font-size: 44px;
}

.unity-button {
    font-size: 44px;
    color: var(--color-text);
    background-color: var(--color-button);
    border-color: var(--color-button-border);
}

.unity-button:hover {
    background-color: var(--color-button-hover);
}

.unity-button:active {
    background-color: var(--color-button-pressed);
}

.menu_button {
    font-size: 56px;
    min-height: 140px;
    margin-top: 2%;
    margin-bottom: 2%;
}

/* Footer: numpad (left half) + mode buttons (right half), both exactly as tall as the
   numpad is wide. Percentage padding is relative to width, so padding-bottom: 50% makes
   the box half as tall as it is wide; the left half is then a square for the numpad and
   both columns share one height, which keeps their top and bottom edges aligned. */
.footer_aspect {
    width: 100%;
    padding-bottom: 50%;
    flex-grow: 0;
    flex-shrink: 0;
}

.footer_inner {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
}

.numpad_container {
    width: 50%;
    height: 100%;
    flex-grow: 0;
    flex-shrink: 0;
}

.numpad {
    flex-grow: 1;
    flex-direction: column;
}

.numpad_row {
    flex-direction: row;
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    min-height: 0;
}

.numpad_button {
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    height: auto;
    min-width: 0;
    min-height: 0;
    /* Same px margin as .game_button, so the two columns line up edge to edge */
    margin: 10px;
    font-size: 72px;
}

/* Selected number in fast mode, and the Fast / Note / Erase mode buttons while on */
.numpad_button.numpad_button_active,
.game_button.game_button_active {
    color: var(--color-accent-text);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
}

.numpad_button.numpad_button_active:hover,
.numpad_button.numpad_button_active:active,
.game_button.game_button_active:hover,
.game_button.game_button_active:active {
    background-color: var(--color-accent);
    opacity: 0.85;
}

.custom_toggle {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 110px;
    padding-left: 24px;
    padding-right: 24px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-divider);
}

.custom_toggle_text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 48px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.custom_toggle_checkbox_parent {
    flex-grow: 0;
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: var(--color-button-border);
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
    transition-property: all;
    transition-duration: 0.12s;
}

.toggle_checkbox {
    width: 60%;
    height: 60%;
    border-radius: 3px;
    background-color: var(--color-accent);
    opacity: 0;
    scale: 0.6 0.6;
    transition-property: all;
    transition-duration: 0.12s;
}

.custom_toggle:hover .custom_toggle_checkbox_parent {
    border-color: var(--color-text-muted);
}

.custom_toggle:active .custom_toggle_checkbox_parent {
    background-color: var(--color-divider);
}

.custom_toggle.checked .custom_toggle_checkbox_parent {
    border-color: var(--color-accent);
}

.custom_toggle.checked .toggle_checkbox {
    opacity: 1;
    scale: 1 1;
}

.game_button_container {
    flex-grow: 1;
    height: 100%;
}

/* Equal shares of the column, so 3 buttons (QuickNote hidden) or 4 fill it the same way */
.game_button {
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin: 10px;
}

.settings_header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 48px;
}

.settings_back_button {
    min-height: 110px;
    padding-left: 32px;
    padding-right: 32px;
    margin-right: 32px;
}

.settings_title {
    font-size: 83px;
}


