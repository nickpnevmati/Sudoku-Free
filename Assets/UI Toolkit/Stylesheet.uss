/* Sizes are in reference pixels: Panel Settings scales the UI from a 1080x1920
   reference, so these grow and shrink with the screen. Unstyled text would fall
   back to the theme's 12px, which is tiny at this resolution. */
:root {
    font-size: 44px;
}

.unity-button {
    font-size: 44px;
}

.menu_button {
    font-size: 56px;
    min-height: 140px;
    margin-top: 2%;
    margin-bottom: 2%;
}

.numpad_container {
    width: 50%;
    max-width: 50%;
    max-height: 100%;
    flex-grow: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.numpad_aspect {
    width: 100%;
    padding-bottom: 100%;
    flex-grow: 0;
    flex-shrink: 0;
}

.numpad_inner {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
}

.numpad_row {
    flex-direction: row;
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    min-height: 0;
}

.numpad_button {
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    height: auto;
    min-width: 0;
    min-height: 0;
    margin: 2%;
    font-size: 72px;
}

.numpad_button.numpad_button_active {
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    height: auto;
    min-width: 0;
    min-height: 0;
    margin: 2%;
}

.custom_toggle {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 110px;
    padding-left: 24px;
    padding-right: 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.custom_toggle_text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 48px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.custom_toggle_checkbox_parent {
    flex-grow: 0;
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: rgb(120, 120, 120);
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
    transition-property: all;
    transition-duration: 0.12s;
}

.toggle_checkbox {
    width: 60%;
    height: 60%;
    border-radius: 3px;
    background-color: rgb(70, 140, 240);
    opacity: 0;
    scale: 0.6 0.6;
    transition-property: all;
    transition-duration: 0.12s;
}

.custom_toggle:hover .custom_toggle_checkbox_parent {
    border-color: rgb(180, 180, 180);
}

.custom_toggle:active .custom_toggle_checkbox_parent {
    background-color: rgba(255, 255, 255, 0.08);
}

.custom_toggle.checked .custom_toggle_checkbox_parent {
    border-color: rgb(70, 140, 240);
}

.custom_toggle.checked .toggle_checkbox {
    opacity: 1;
    scale: 1 1;
}

.game_button {
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 5%;
}

.game_button_last {
    margin-bottom: 0;
}


